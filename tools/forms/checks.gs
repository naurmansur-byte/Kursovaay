function createUnderstandingChecks() {
  const root = DriveApp.getFolderById(CHK_ROOT);
  const found = root.getFoldersByName(CHK_FOLDER);
  const folder = found.hasNext() ? found.next() : root.createFolder(CHK_FOLDER);
  const sheets = {};
  const out = ['Папка: ' + folder.getUrl()];
  CHK_FORMS.forEach(c => {
    if (!sheets[c.subject]) sheets[c.subject] = chkSheet_(folder, 'ХимБио просто — проверка понимания: ' + c.subjectName.toLowerCase() + ' — ответы');
    out.push(chkBuild_(c, folder, sheets[c.subject]));
  });
  Object.keys(sheets).forEach(k => out.push('Таблица ' + k + ': ' + sheets[k].getUrl()));
  Logger.log(out.join('\n'));
}

function chkSheet_(folder, name) {
  const it = folder.getFilesByName(name);
  if (it.hasNext()) return SpreadsheetApp.openById(it.next().getId());
  const ss = SpreadsheetApp.create(name);
  DriveApp.getFileById(ss.getId()).moveTo(folder);
  return ss;
}

function chkBuild_(c, folder, ss) {
  const old = folder.getFilesByName(c.title);
  if (old.hasNext()) {
    const f = FormApp.openById(old.next().getId());
    return 'есть: ' + c.title + ' — ' + f.getPublishedUrl();
  }
  const form = FormApp.create(c.title);
  form.setDescription(c.intro)
    .setIsQuiz(true)
    .setProgressBar(false)
    .setAllowResponseEdits(false)
    .setPublishingSummary(false)
    .setShowLinkToRespondAgain(false)
    .setConfirmationMessage('Спасибо! Нажми «Посмотреть баллы»: там твои ошибки, верные ответы и объяснения.');
  form.addTextItem().setTitle(CHK_NAME_Q).setRequired(true);
  c.questions.forEach(q => {
    const it = form.addMultipleChoiceItem().setTitle(q.q).setRequired(true).setPoints(1);
    it.setChoices(q.o.map(o => it.createChoice(o, o === q.a)));
    it.setFeedbackForCorrect(FormApp.createFeedback().setText('Верно. ' + q.e).build());
    it.setFeedbackForIncorrect(FormApp.createFeedback().setText('Верный ответ: ' + q.a + '. ' + q.e).build());
  });
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());
  const url = form.getPublishedUrl().replace(/\/viewform.*$/, '');
  let sh = null;
  for (let i = 0; i < 20 && !sh; i++) {
    SpreadsheetApp.flush();
    sh = SpreadsheetApp.openById(ss.getId()).getSheets().filter(s => (s.getFormUrl() || '').indexOf(form.getId()) >= 0 || (s.getFormUrl() || '').replace(/\/viewform.*$/, '') === url)[0] || null;
    if (!sh) Utilities.sleep(1000);
  }
  const book = SpreadsheetApp.openById(ss.getId());
  if (sh) sh.setName('Неделя ' + c.week);
  book.getSheets().filter(s => !s.getFormUrl() && book.getSheets().length > 1).forEach(s => book.deleteSheet(s));
  DriveApp.getFileById(form.getId()).moveTo(folder);
  return c.subjectName + ', неделя ' + c.week + ': ' + form.getPublishedUrl() + ' | редактирование — ' + form.getEditUrl();
}
