function createPlacementForms() {
  const folder = DriveApp.getFolderById(DRIVE_ROOT).createFolder(DRIVE_FOLDER);
  const out = TESTS.map(t => buildTest_(t, folder));
  Logger.log('Папка: ' + folder.getUrl() + '\n' + out.join('\n'));
}

function buildTest_(t, folder) {
  const form = FormApp.create(t.title);
  form.setDescription(t.intro)
    .setIsQuiz(false)
    .setProgressBar(true)
    .setAllowResponseEdits(false)
    .setPublishingSummary(false)
    .setShowLinkToRespondAgain(false)
    .setConfirmationMessage('Спасибо! Ответы получены. Результат по темам преподаватель обсудит с тобой лично.');
  form.addTextItem().setTitle(NAME_Q).setRequired(true);
  t.parts.forEach(p => {
    form.addPageBreakItem().setTitle(p.title);
    t.questions.filter(q => p.weeks.indexOf(q.w) >= 0).forEach(q => {
      const it = form.addMultipleChoiceItem().setTitle(q.q).setRequired(true);
      it.setChoiceValues(q.o);
    });
  });
  const ss = SpreadsheetApp.create(t.title + ' — ответы');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());
  let resp = null;
  for (let i = 0; i < 20 && !resp; i++) {
    SpreadsheetApp.flush();
    resp = SpreadsheetApp.openById(ss.getId()).getSheets().filter(s => s.getFormUrl())[0] || null;
    if (!resp) Utilities.sleep(1000);
  }
  if (!resp) throw new Error('Не нашёл лист ответов в ' + ss.getUrl());
  buildSummary_(SpreadsheetApp.openById(ss.getId()), resp, t);
  DriveApp.getFileById(form.getId()).moveTo(folder);
  DriveApp.getFileById(ss.getId()).moveTo(folder);
  return t.subject + ': ответы ученика — ' + form.getPublishedUrl() + ' | редактирование — ' + form.getEditUrl() + ' | таблица — ' + ss.getUrl();
}

/** Пересобрать лист «По неделям» в уже созданных таблицах (после правки формул). */
function rebuildSummaries() {
  const out = [];
  TESTS.forEach(t => {
    const it = DriveApp.getFilesByName(t.title + ' — ответы');
    while (it.hasNext()) {
      const f = it.next();
      if (f.getMimeType() !== MimeType.GOOGLE_SHEETS) continue;
      const ss = SpreadsheetApp.openById(f.getId());
      const resp = ss.getSheets().filter(s => s.getFormUrl())[0];
      if (resp) { buildSummary_(ss, resp, t); out.push(t.subject + ': ' + ss.getUrl()); }
    }
  });
  Logger.log(out.join('\n'));
}

function buildSummary_(ss, resp, t) {
  // Формулы пишем с запятыми — в русской локали они не разбираются, поэтому таблица в en_US.
  ss.setSpreadsheetLocale('en_US');
  SpreadsheetApp.flush();
  const respName = resp.getName();
  const lastCol = resp.getRange(1, resp.getMaxColumns()).getA1Notation().replace(/\d+/g, '');
  const sh = ss.getSheets().filter(s => !s.getFormUrl())[0] || ss.insertSheet();
  sh.setName('По неделям');
  ss.setActiveSheet(sh);
  ss.moveActiveSheet(1);
  const R = "'" + respName.replace(/'/g, "''") + "'!";
  const esc = s => String(s).replace(/"/g, '""');
  const col = title => 'INDEX(' + R + 'A2:' + lastCol + ',0,MATCH("' + esc(title) + '",' + R + '1:1,0))';
  const name = col(NAME_Q);
  const hit = q => '(' + col(q.q) + '="' + esc(q.a) + '")';
  const weeks = Object.keys(t.weeks).map(Number).sort((a, b) => a - b);
  const last = 2 + weeks.length;
  const head = ['Ученик', 'Всего из ' + t.questions.length].concat(weeks.map(w => 'Н' + w + ' ' + t.weeks[w]));
  sh.getRange(1, 1, 1, head.length).setValues([head]).setFontWeight('bold').setWrap(true).setVerticalAlignment('top');
  sh.getRange(2, 1).setValue('Знают тему (2 из 2), доля группы');
  sh.getRange(3, 1).setValue('Не знают (0 из 2), доля группы');
  sh.getRange(4, 1).setFormula('=ARRAYFORMULA(IFERROR(IF(' + name + '="",,' + name + '),))');
  sh.getRange(4, 2).setFormula('=ARRAYFORMULA(IFERROR(IF(' + name + '="",,' + t.questions.map(hit).join('+') + '),))');
  weeks.forEach((w, i) => {
    const qs = t.questions.filter(q => q.w === w);
    const c = 3 + i;
    const L = sh.getRange(1, c).getA1Notation().replace(/\d+/g, '');
    sh.getRange(4, c).setFormula('=ARRAYFORMULA(IFERROR(IF(' + name + '="",,' + qs.map(hit).join('+') + '),))');
    sh.getRange(2, c).setFormula('=IFERROR(COUNTIF(' + L + '4:' + L + ',2)/COUNT($B$4:$B),)');
    sh.getRange(3, c).setFormula('=IFERROR(COUNTIF(' + L + '4:' + L + ',0)/COUNT($B$4:$B),)');
  });
  sh.getRange(2, 3, 2, weeks.length).setNumberFormat('0%').setFontWeight('bold');
  const data = sh.getRange(4, 3, 200, weeks.length);
  const rule = (v, color) => SpreadsheetApp.newConditionalFormatRule().whenFormulaSatisfied('=AND(ISNUMBER(C4),C4=' + v + ')').setBackground(color).setRanges([data]).build();
  sh.setConditionalFormatRules([rule(2, '#c8e6c9'), rule(1, '#fff3c4'), rule(0, '#f8c9c4')]);
  sh.setFrozenRows(3);
  sh.setFrozenColumns(2);
  sh.setColumnWidth(1, 200);
  sh.setColumnWidths(3, weeks.length, 90);
  sh.setRowHeight(1, 60);
  sh.getRange(1, 1, 3, last).setBackground('#eef3ff');
  sh.getRange(1, last + 2).setValue('2 — знает (зелёный), 1 — повторить (жёлтый), 0 — с нуля (красный). «Не знаю» = 0.');
}
